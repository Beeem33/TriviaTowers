# Copy to apps/web/.env.local for local overrides. Phase 1 needs none of these.

# Public base URL used in share text and challenge links.
# Leave unset locally (the current origin is used). Production: https://triviatowers.io
NEXT_PUBLIC_SITE_URL=

# --- Supabase (public, safe in the browser; defaults to the TriviaTowers project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to "false" to build a fully offline app (the single-file preview does this).
NEXT_PUBLIC_ONLINE=

# --- Tooling only (supabase/scripts). A Supabase personal access token (sbp_...). Never commit. ---
# SUPABASE_ACCESS_TOKEN=

# --- Server-side only. NEVER prefix with NEXT_PUBLIC_, never commit real values. ---
# Lives in Supabase Edge Function secrets (supabase secrets set ...), not in the web app.
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Phase 6 ---
NEXT_PUBLIC_ADSENSE_CLIENT=
