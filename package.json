{
  "name": "triviatowers",
  "private": true,
  "version": "0.1.0",
  "description": "TriviaTowers.io — daily multiplayer trivia where every correct answer builds your tower.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @triviatowers/web",
    "build": "npm run build -w @triviatowers/web",
    "start": "npm run start -w @triviatowers/web",
    "lint": "npm run lint -w @triviatowers/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @triviatowers/web"
  }
}
