/**
 * Writes supabase/seed/questions.sql from the game-core question bank (idempotent upsert).
 * Usage: npx tsx supabase/scripts/export-questions.mts
 */
import { writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { SAMPLE_QUESTIONS } from "../../packages/game-core/src/index";

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const rows = SAMPLE_QUESTIONS.map(
  (x) =>
    `(${q(x.id)}, ${q(x.prompt)}, array[${x.choices.map(q).join(", ")}], ${x.correctIndex}, ${q(x.category)}, ${q(x.difficulty)}, ${q(x.explanation)}, ${q(x.source)}, ${q(x.reviewStatus)})`,
);
const sql = `-- Generated by supabase/scripts/export-questions.mts from packages/game-core. Do not edit by hand.
-- Upserts content but never downgrades a review decision made in the database.
insert into public.questions (id, prompt, choices, correct_index, category, difficulty, explanation, source, review_status) values
${rows.join(",\n")}
on conflict (id) do update set
  prompt = excluded.prompt,
  choices = excluded.choices,
  correct_index = excluded.correct_index,
  category = excluded.category,
  difficulty = excluded.difficulty,
  explanation = excluded.explanation,
  source = excluded.source,
  updated_at = now();
`;
const out = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../seed/questions.sql");
writeFileSync(out, sql);
console.log(`Wrote ${SAMPLE_QUESTIONS.length} questions to ${path.relative(process.cwd(), out)}`);
